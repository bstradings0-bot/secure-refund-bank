# ==========================================
# SecureRefund Bank - Production Environment
# ==========================================
# Copy this file to .env.production and fill in the values
# NEVER commit .env.production to version control!

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# PostgreSQL connection string (required)
# Format: postgresql://user:password@host:5432/database?sslmode=require
# Examples:
#   Neon: postgresql://user:password@ep-xxx.region.provider.neon.tech/dbname?sslmode=require
#   Railway: postgresql://user:password@containers-us-west-xxx.railway.app:7xxx/railway
#   Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/SECUREBANK_DB?sslmode=require&connection_limit=20"

# ==========================================
# SECURITY SECRETS
# ==========================================
# Generate these using: node scripts/generate-secrets.js
# Each should be a random 64-character hex string

JWT_SECRET="CHANGE_ME_generate_with_node_scripts_generate-secrets.js"
JWT_REFRESH_SECRET="CHANGE_ME_generate_with_node_scripts_generate-secrets.js"
COOKIE_SECRET="CHANGE_ME_generate_with_node_scripts_generate-secrets.js"
NEXTAUTH_SECRET="CHANGE_ME_generate_with_node_scripts_generate-secrets.js"

# JWT Configuration
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ==========================================
# APPLICATION SETTINGS
# ==========================================
NODE_ENV="production"
PORT=4000

# CORS - Your production domain(s)
# Comma-separated for multiple domains
CORS_ORIGIN="https://your-domain.com,https://www.your-domain.com"

# ==========================================
# ADMIN CREDENTIALS
# ==========================================
# Change these before first production deployment!
ADMIN_EMAIL="admin@securebank.com"
ADMIN_PASSWORD="CHANGE_ME_to_a_very_strong_password"

# ==========================================
# EMAIL SERVICE (for OTP verification)
# ==========================================
# Using Gmail as example - replace with your email provider
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
EMAIL_FROM="noreply@securebank.com"
EMAIL_FROM_NAME="SecureRefund Bank"

# ==========================================
# PAYMENT INTEGRATIONS (Optional)
# ==========================================
# Stripe for payments
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."

# Plaid for bank account linking
PLAID_CLIENT_ID="..."
PLAID_SECRET="..."
PLAID_ENV="production"  # or "sandbox" for testing

# Wise for international transfers
WISE_API_KEY="..."
WISE_PROFILE_ID="..."

# ==========================================
# MONITORING & LOGGING
# ==========================================
# Optional: Sentry for error tracking
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# Optional: Log level
LOG_LEVEL="info"  # error, warn, info, debug

# ==========================================
# DATABASE CONNECTION POOL
# ==========================================
# Adjust based on your hosting plan limits
# Neon free tier: 20 connections
# Railway: varies by plan
DB_CONNECTION_LIMIT="20"
DB_IDLE_TIMEOUT="30000"
DB_CONNECTION_TIMEOUT="5000"

# ==========================================
# FEATURE FLAGS
# ==========================================
# Enable/disable features
ENABLE_EMAIL_VERIFICATION=true
ENABLE_2FA=true
ENABLE_KYC=true
ENABLE_REFUNDS=true
ENABLE_DISPUTES=true

# Demo data (set to false in production)
SEED_DEMO_DATA=false

# ==========================================
# RATE LIMITING
# ==========================================
# API rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# SESSION CONFIGURATION
# ==========================================
SESSION_SECRET="CHANGE_ME_same_as_COOKIE_SECRET"
SESSION_MAX_AGE=1800000  # 30 minutes in milliseconds

# ==========================================
# FILE UPLOAD
# ==========================================
# Maximum file size for uploads (KYC documents, etc.)
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES="image/jpeg,image/png,application/pdf"

# ==========================================
# DEPLOYMENT PLATFORM
# ==========================================
# Set this to your hosting platform for platform-specific optimizations
# Options: vercel, railway, render, aws, digitalocean, custom
DEPLOYMENT_PLATFORM="vercel"

# ==========================================
# NEXT.JS SPECIFIC (for web app)
# ==========================================
NEXT_PUBLIC_API_URL="https://api.your-domain.com"
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
