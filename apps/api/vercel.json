{
  "installCommand": "npx pnpm@9 install --no-frozen-lockfile --filter @srb/api",
  "buildCommand": "npx prisma generate --schema=packages/database/prisma/schema.prisma && cd packages/database && npx tsc && cd ../shared && npx tsc",
  "builds": [
    {
      "src": "apps/api/api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["packages/**/*"],
        "nodeBundler": "esbuild"
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "apps/api/api/index.ts" }
  ]
}
