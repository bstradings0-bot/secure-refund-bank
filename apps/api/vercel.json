{
  "rootDirectory": ".",
  "installCommand": "npx pnpm@9 install --no-frozen-lockfile --filter @srb/api",
  "buildCommand": "npx prisma generate --schema=packages/database/prisma/schema.prisma",
  "builds": [
    {
      "src": "apps/api/api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "apps/api/api/index.ts" }
  ]
}
