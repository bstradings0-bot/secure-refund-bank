# ============================================================
# SecureRefund Bank — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values for production.
# Never commit .env files containing real secrets to version control.

# ---- Server ----
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
COOKIE_SECRET=change-me-to-a-random-string-at-least-32-chars

# ---- Database ----
DATABASE_URL=postgresql://srb_user:srb_password@localhost:5432/secure_refund_bank

# ---- JWT ----
JWT_SECRET=change-me-to-a-random-string-at-least-64-chars
JWT_REFRESH_SECRET=change-me-to-another-random-string

# ---- Encryption (AES-256-GCM key, must be exactly 32 characters) ----
ENCRYPTION_KEY=change-me-exactly-32-characters!!

# ---- CSRF ----
CSRF_SECRET=change-me-to-a-random-csrf-secret

# ---- Stripe (https://dashboard.stripe.com/apikeys) ----
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# ---- Plaid (https://dashboard.plaid.com/developers/keys) ----
PLAID_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
PLAID_SECRET=xxxxxxxxxxxxxxxxxxxx
PLAID_ENV=sandbox                # sandbox | development | production

# ---- Wise (https://api-docs.wise.com) ----
WISE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
WISE_ENV=sandbox                 # sandbox | live
WISE_PROFILE_ID=12345678

# ---- Compliance ----
AML_THRESHOLD=10000              # USD threshold triggering automatic AML review
KYC_PROVIDER=INTERNAL            # INTERNAL | ONFIDO | SUMSUB | PERSONA

# ---- File Uploads ----
MAX_FILE_SIZE=10485760           # 10 MB in bytes
UPLOAD_DIR=uploads               # Relative to project root
